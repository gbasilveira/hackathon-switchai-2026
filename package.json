{
  "name": "switch-cortex",
  "version": "1.0.0",
  "description": "Deterministic BPMN 2.0, DMN 1.3 & FEEL Governance Cortex for Multi-Agent Switch AI Rooms",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "switch-ai",
    "wemakedevs",
    "flip-the-switch",
    "mcp",
    "model-context-protocol",
    "bpmn",
    "dmn",
    "feel",
    "multi-agent",
    "formal-verification",
    "guardrails",
    "governance"
  ],
  "bin": {
    "switch-cortex": "./dist/src/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "blueprints",
    "switch-workspace",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "demo": "node dist/src/cli/index.js demo",
    "live": "node dist/src/cli/index.js live",
    "verify": "node dist/src/cli/index.js verify",
    "mcp": "node dist/src/cli/index.js mcp",
    "serve": "node dist/src/cli/index.js serve --port 4100",
    "export-blueprints": "node dist/src/cli/index.js export-blueprints"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
