<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="dmn_release_and_infra_governance_defs" name="Multi-Department Release &amp; Cloud Infrastructure Governance" namespace="urn:switch-cortex:dmn:1.3">
  <decision id="dmn_release_and_infra_governance" name="Multi-Department Release &amp; Cloud Infrastructure Governance">
    <decisionTable id="dmn_release_and_infra_governance_table" hitPolicy="PRIORITY">
      <input id="in_env" label="Target Environment">
        <inputExpression id="in_env_expr" typeRef="string">
          <text>env</text>
        </inputExpression>
      </input>
      <input id="in_cost" label="Monthly Cost Delta ($)">
        <inputExpression id="in_cost_expr" typeRef="number">
          <text>cost_delta</text>
        </inputExpression>
      </input>
      <input id="in_pii" label="Touches Customer PII">
        <inputExpression id="in_pii_expr" typeRef="boolean">
          <text>touches_pii</text>
        </inputExpression>
      </input>
      <input id="in_public" label="Public Network Exposure">
        <inputExpression id="in_public_expr" typeRef="boolean">
          <text>public_exposure</text>
        </inputExpression>
      </input>
      <input id="in_conf" label="Agent Proposal Confidence">
        <inputExpression id="in_conf_expr" typeRef="number">
          <text>confidence</text>
        </inputExpression>
      </input>
      <output id="out_verdict" name="verdict" label="Governance Verdict" typeRef="string" />
      <output id="out_approver" name="required_approver" label="Required Human Approver" typeRef="string" />
      <output id="out_note" name="policy_note" label="Policy Justification" typeRef="string" />
      <rule id="R1_BLOCK_PUBLIC_PII">
        <description>Hard invariant: Never allow public exposure when touching customer PII</description>
        <inputEntry id="R1_BLOCK_PUBLIC_PII_in_0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R1_BLOCK_PUBLIC_PII_in_1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R1_BLOCK_PUBLIC_PII_in_2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="R1_BLOCK_PUBLIC_PII_in_3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="R1_BLOCK_PUBLIC_PII_in_4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="R1_BLOCK_PUBLIC_PII_out_0">
          <text>&quot;reject&quot;</text>
        </outputEntry>
        <outputEntry id="R1_BLOCK_PUBLIC_PII_out_1">
          <text>&quot;none&quot;</text>
        </outputEntry>
        <outputEntry id="R1_BLOCK_PUBLIC_PII_out_2">
          <text>&quot;Hard compliance invariant violated: PII workload cannot have public network exposure&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R2_BLOCK_EXCESSIVE_COST">
        <description>Hard budget cap: Reject any single tactical request exceeding $10,000/mo</description>
        <inputEntry id="R2_BLOCK_EXCESSIVE_COST_in_0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R2_BLOCK_EXCESSIVE_COST_in_1">
          <text>&gt; 10000</text>
        </inputEntry>
        <inputEntry id="R2_BLOCK_EXCESSIVE_COST_in_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R2_BLOCK_EXCESSIVE_COST_in_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R2_BLOCK_EXCESSIVE_COST_in_4">
          <text>-</text>
        </inputEntry>
        <outputEntry id="R2_BLOCK_EXCESSIVE_COST_out_0">
          <text>&quot;reject&quot;</text>
        </outputEntry>
        <outputEntry id="R2_BLOCK_EXCESSIVE_COST_out_1">
          <text>&quot;none&quot;</text>
        </outputEntry>
        <outputEntry id="R2_BLOCK_EXCESSIVE_COST_out_2">
          <text>&quot;Tactical cost ceiling exceeded (&gt; $10,000/mo); requires quarterly architecture board&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R3_LOW_CONFIDENCE_ESCALATION">
        <description>Conservative AI guardrail: Below 0.80 confidence always escalates to human + departments</description>
        <inputEntry id="R3_LOW_CONFIDENCE_ESCALATION_in_0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R3_LOW_CONFIDENCE_ESCALATION_in_1">
          <text>&lt;= 10000</text>
        </inputEntry>
        <inputEntry id="R3_LOW_CONFIDENCE_ESCALATION_in_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R3_LOW_CONFIDENCE_ESCALATION_in_3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="R3_LOW_CONFIDENCE_ESCALATION_in_4">
          <text>&lt; 0.80</text>
        </inputEntry>
        <outputEntry id="R3_LOW_CONFIDENCE_ESCALATION_out_0">
          <text>&quot;require_dept_signoff&quot;</text>
        </outputEntry>
        <outputEntry id="R3_LOW_CONFIDENCE_ESCALATION_out_1">
          <text>&quot;@eng-manager&quot;</text>
        </outputEntry>
        <outputEntry id="R3_LOW_CONFIDENCE_ESCALATION_out_2">
          <text>&quot;Agent confidence below 0.80 threshold; escalated to Security, FinOps &amp; Engineering Manager&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII">
        <description>Low confidence on non-PII public endpoint also escalates to CISO</description>
        <inputEntry id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII_in_0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII_in_1">
          <text>&lt;= 10000</text>
        </inputEntry>
        <inputEntry id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII_in_2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII_in_3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII_in_4">
          <text>&lt; 0.80</text>
        </inputEntry>
        <outputEntry id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII_out_0">
          <text>&quot;require_exec_and_dept_signoff&quot;</text>
        </outputEntry>
        <outputEntry id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII_out_1">
          <text>&quot;@ciso&quot;</text>
        </outputEntry>
        <outputEntry id="R4_LOW_CONFIDENCE_PUBLIC_NON_PII_out_2">
          <text>&quot;Low-confidence public endpoint change requires Security, FinOps &amp; CISO approval&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R5_PROD_PII_CISO_GATE">
        <description>Production changes touching internal PII require multi-department review + CISO sign-off</description>
        <inputEntry id="R5_PROD_PII_CISO_GATE_in_0">
          <text>&quot;prod&quot;</text>
        </inputEntry>
        <inputEntry id="R5_PROD_PII_CISO_GATE_in_1">
          <text>&lt;= 10000</text>
        </inputEntry>
        <inputEntry id="R5_PROD_PII_CISO_GATE_in_2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="R5_PROD_PII_CISO_GATE_in_3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="R5_PROD_PII_CISO_GATE_in_4">
          <text>&gt;= 0.80</text>
        </inputEntry>
        <outputEntry id="R5_PROD_PII_CISO_GATE_out_0">
          <text>&quot;require_exec_and_dept_signoff&quot;</text>
        </outputEntry>
        <outputEntry id="R5_PROD_PII_CISO_GATE_out_1">
          <text>&quot;@ciso&quot;</text>
        </outputEntry>
        <outputEntry id="R5_PROD_PII_CISO_GATE_out_2">
          <text>&quot;Production PII access requires parallel Security + FinOps review and CISO human sign-off&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R6_PROD_STANDARD_MULTI_DEPT">
        <description>All production changes or medium-cost changes ($101..$10,000) require Security + FinOps + Eng Manager</description>
        <inputEntry id="R6_PROD_STANDARD_MULTI_DEPT_in_0">
          <text>&quot;prod&quot;</text>
        </inputEntry>
        <inputEntry id="R6_PROD_STANDARD_MULTI_DEPT_in_1">
          <text>&lt;= 10000</text>
        </inputEntry>
        <inputEntry id="R6_PROD_STANDARD_MULTI_DEPT_in_2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="R6_PROD_STANDARD_MULTI_DEPT_in_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R6_PROD_STANDARD_MULTI_DEPT_in_4">
          <text>&gt;= 0.80</text>
        </inputEntry>
        <outputEntry id="R6_PROD_STANDARD_MULTI_DEPT_out_0">
          <text>&quot;require_dept_signoff&quot;</text>
        </outputEntry>
        <outputEntry id="R6_PROD_STANDARD_MULTI_DEPT_out_1">
          <text>&quot;@eng-manager&quot;</text>
        </outputEntry>
        <outputEntry id="R6_PROD_STANDARD_MULTI_DEPT_out_2">
          <text>&quot;Production operation requires parallel @sec-agent + @finops-agent audit and @eng-manager sign-off&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R7_NON_PROD_HIGH_COST_OR_PII">
        <description>Staging/Dev changes over $100/mo or touching internal PII require multi-department review</description>
        <inputEntry id="R7_NON_PROD_HIGH_COST_OR_PII_in_0">
          <text>&quot;dev&quot;, &quot;staging&quot;</text>
        </inputEntry>
        <inputEntry id="R7_NON_PROD_HIGH_COST_OR_PII_in_1">
          <text>[101..10000]</text>
        </inputEntry>
        <inputEntry id="R7_NON_PROD_HIGH_COST_OR_PII_in_2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R7_NON_PROD_HIGH_COST_OR_PII_in_3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="R7_NON_PROD_HIGH_COST_OR_PII_in_4">
          <text>&gt;= 0.80</text>
        </inputEntry>
        <outputEntry id="R7_NON_PROD_HIGH_COST_OR_PII_out_0">
          <text>&quot;require_dept_signoff&quot;</text>
        </outputEntry>
        <outputEntry id="R7_NON_PROD_HIGH_COST_OR_PII_out_1">
          <text>&quot;@eng-manager&quot;</text>
        </outputEntry>
        <outputEntry id="R7_NON_PROD_HIGH_COST_OR_PII_out_2">
          <text>&quot;Non-prod spend &gt; $100/mo requires @finops-agent + @sec-agent review and @eng-manager approval&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R8_NON_PROD_PII_INTERNAL">
        <description>Staging/Dev changes touching internal PII even at low cost require multi-department review</description>
        <inputEntry id="R8_NON_PROD_PII_INTERNAL_in_0">
          <text>&quot;dev&quot;, &quot;staging&quot;</text>
        </inputEntry>
        <inputEntry id="R8_NON_PROD_PII_INTERNAL_in_1">
          <text>&lt;= 100</text>
        </inputEntry>
        <inputEntry id="R8_NON_PROD_PII_INTERNAL_in_2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="R8_NON_PROD_PII_INTERNAL_in_3">
          <text>false</text>
        </inputEntry>
        <inputEntry id="R8_NON_PROD_PII_INTERNAL_in_4">
          <text>&gt;= 0.80</text>
        </inputEntry>
        <outputEntry id="R8_NON_PROD_PII_INTERNAL_out_0">
          <text>&quot;require_dept_signoff&quot;</text>
        </outputEntry>
        <outputEntry id="R8_NON_PROD_PII_INTERNAL_out_1">
          <text>&quot;@eng-manager&quot;</text>
        </outputEntry>
        <outputEntry id="R8_NON_PROD_PII_INTERNAL_out_2">
          <text>&quot;Internal PII dataset usage in non-prod requires Security + FinOps review&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R9_NON_PROD_PUBLIC_LOW_COST">
        <description>Staging/Dev public exposure without PII over $100/mo requires department review</description>
        <inputEntry id="R9_NON_PROD_PUBLIC_LOW_COST_in_0">
          <text>&quot;dev&quot;, &quot;staging&quot;</text>
        </inputEntry>
        <inputEntry id="R9_NON_PROD_PUBLIC_LOW_COST_in_1">
          <text>[101..10000]</text>
        </inputEntry>
        <inputEntry id="R9_NON_PROD_PUBLIC_LOW_COST_in_2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="R9_NON_PROD_PUBLIC_LOW_COST_in_3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="R9_NON_PROD_PUBLIC_LOW_COST_in_4">
          <text>&gt;= 0.80</text>
        </inputEntry>
        <outputEntry id="R9_NON_PROD_PUBLIC_LOW_COST_out_0">
          <text>&quot;require_dept_signoff&quot;</text>
        </outputEntry>
        <outputEntry id="R9_NON_PROD_PUBLIC_LOW_COST_out_1">
          <text>&quot;@eng-manager&quot;</text>
        </outputEntry>
        <outputEntry id="R9_NON_PROD_PUBLIC_LOW_COST_out_2">
          <text>&quot;Public non-prod endpoint &gt; $100/mo requires Security + FinOps sign-off&quot;</text>
        </outputEntry>
      </rule>
      <rule id="R10_GREEN_LANE_AUTO_APPROVE">
        <description>Green Lane: Dev/Staging, cost &lt;= $100/mo, no PII, confidence &gt;= 0.80 -&gt; 100% Automatic Approval</description>
        <inputEntry id="R10_GREEN_LANE_AUTO_APPROVE_in_0">
          <text>&quot;dev&quot;, &quot;staging&quot;</text>
        </inputEntry>
        <inputEntry id="R10_GREEN_LANE_AUTO_APPROVE_in_1">
          <text>&lt;= 100</text>
        </inputEntry>
        <inputEntry id="R10_GREEN_LANE_AUTO_APPROVE_in_2">
          <text>false</text>
        </inputEntry>
        <inputEntry id="R10_GREEN_LANE_AUTO_APPROVE_in_3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="R10_GREEN_LANE_AUTO_APPROVE_in_4">
          <text>&gt;= 0.80</text>
        </inputEntry>
        <outputEntry id="R10_GREEN_LANE_AUTO_APPROVE_out_0">
          <text>&quot;auto_approve&quot;</text>
        </outputEntry>
        <outputEntry id="R10_GREEN_LANE_AUTO_APPROVE_out_1">
          <text>&quot;none&quot;</text>
        </outputEntry>
        <outputEntry id="R10_GREEN_LANE_AUTO_APPROVE_out_2">
          <text>&quot;Green Lane Fast-Track: Low-cost non-prod change with high confidence and zero PII&quot;</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
